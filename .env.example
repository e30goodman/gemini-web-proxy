# Copy to .env and edit. The proxy reads cookies from the Firefox profile that
# you log into via scripts/gemini-login.sh.

HOST=127.0.0.1
PORT=9658

# Firefox profile directory that holds the logged-in Google session
# (the bridge uses ~/.mozilla/firefox/gemini-pump.default by default).
# FIREFOX_PROFILE=
# GEMINI_PUMP_PROFILE=

# Where artifacts live (default: src/var/)
# GEMINI_RATE_STATE_FILE=
# GEMINI_SESSION_DB=
# GEMINI_DECISION_LOG=
# GEMINI_JUDGE_LOG=
# WATCH_BUFFER_FILE=

# Optional API key the proxy requires from clients (empty = no auth)
PROXY_API_KEY=

# Route generation through the real-Firefox X11/AT-SPI bridge (1) or the
# cookie-based gemini_webapi client (0, usually soft-refused by Google now).
GEMINI_USE_ATSPI_BRIDGE=1
GEMINI_ATSPI_PYTHON=/usr/bin/python3
GEMINI_ATSPI_BRIDGE_SCRIPT=src/gemini_atspi_bridge.py
GEMINI_ATSPI_RESPONSE_TIMEOUT=120
GEMINI_ATSPI_SUBPROCESS_TIMEOUT=900
GEMINI_DISPLAY=:2

# X11/DBUS session for the AT-SPI bridge/watcher (systemd services only).
XDG_RUNTIME_DIR=/run/user/1000
DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/1000/bus

# Rate limiting (protects the Google account from 'unusual traffic' bans).
GEMINI_RATE_MAX_PER_MIN=4
GEMINI_RATE_MAX_PER_HOUR=40
GEMINI_RATE_MIN_GAP_S=8

# Judge (free-model "should we nudge?") — leave empty to disable.
JUDGE_ENABLED=0
# Decision guard (cheap model watches every text answer) — set key to enable.
DECISION_API_KEY=
# Optional egress tunnel (leave empty for direct egress).
GEMINI_EGRESS_PROXY=
GEMINI_EGRESS_ENSURE_SCRIPT=

# DELTA mode: on continue send only the messages new since Gemini's last answer.
GEMINI_DELTA=1
# fresh chat after N continue steps (page weight)
GEMINI_DELTA_ROLLOVER=40
# 1 = every delta carries the tool schemas, 0 = only when the tool set changed
GEMINI_DELTA_SCHEMAS=1
# bridge: seconds to verify the saved chat really opened (else exit 4 -> fresh chat)
GEMINI_NAV_VERIFY_S=6

# LIMIT WAIT: target model out of quota -> park agent turns until the reset time
# shown on the page (wait), or answer on the smaller model with a notice (lite).
GEMINI_LIMIT_MODE=wait
# GEMINI_LIMIT_TZ=   # default: the system time zone
# probe interval when the page shows no reset time; wake margin after the reset
GEMINI_LIMIT_PROBE_S=900
GEMINI_LIMIT_MARGIN_S=90
# keepalive chunk interval while parked (Hermes stale detector needs data chunks)
GEMINI_LIMIT_KEEPALIVE_S=20
